@model Pelicula

<br /><h1>@ViewBag.Titulo</h1><br />
<div class="contenido-pelicula">
    <div class="datos-pelicula">
        <h2>@Model.Titulo</h2>
        <p>@Model.Sinopsis</p>
        <br />
        <div class="tabla">
            <div class="fila">
                <div class="celda-titulo">Título Original :</div>
                <div class="celda">@Model.Titulo</div>
            </div>
            <div class="fila">
                <div class="celda-titulo">Estreno :</div>
                <div class="celda">@Model.FechaEstrenoTexto</div>
            </div>
            <div class="fila">
                <div class="celda-titulo">Género :</div>
                <div class="celda">@Model.GenerosTexto</div>
            </div>
            <div class="fila">
                <div class="celda-titulo">Director :</div>
                <div class="celda">@Model.Director</div>
            </div>
            <div class="fila">
                <div class="celda-titulo">Reparto :</div>
                <div class="celda">@Model.Reparto</div>
            </div>
        </div>
    </div>
    <img src="~/img/pelicula/@(Model.Id).jpg" width="160" height="226"><br /><br />
</div>
<div class="pelicula-video">
    <iframe width="580" height="400" src="https://www.youtube.com/embed/@Model.Link" title="Trailer" frameborder="0" allowfullscreen></iframe>
</div>
